rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users profiles: Public read, Owner write
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
      
      // User data: Owner only (Scores, AI Chats, etc.)
      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Global Leaderboards: Public read, Authenticated write
    match /leaderboards/{testId}/scores/{scoreId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Study Sets: Public read, Authenticated write for metrics (likes, saves, learners)
    match /study_sets/{setId} {
      allow read: if true;
      allow update: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if false;

      // Ratings: User can only read/write their own rating
      match /ratings/{uid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Config: Public read, No write
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Logs: Anonymous write, Public read
    match /logs/{logId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    // Reports: Anonymous write, No read
    match /reports/{reportId} {
      allow create: if request.resource.data.message is string && request.resource.data.message.size() > 0;
      allow read, update, delete: if false;
    }
  }
}
